# SmartSharePhoto Unified Environment Variables Guide

# -----------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartsharephoto_dev
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smartsharephoto_dev

# Supabase Auth JWT Verification
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars-length
SUPABASE_ALGORITHM=HS256

# Cloudflare R2 Object Storage Credentials
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=smartsharephoto-photos
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_PROVIDER=mock  # Options: 'r2', 'mock'

# Limits
MAX_PHOTOS_PER_EVENT=150

# -----------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000
